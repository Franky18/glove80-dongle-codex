/* Automatically generated combos definitions */
/ {
    combos {
        compatible = "zmk,combos";

        combo_cb_numl {
            key-positions = <POS_LH_C3R5 POS_LH_C4R5>;
            bindings = <&tog LAYER_Numbers>;
            layers = <LAYER_Homerow_Mods LAYER_Numbers LAYER_Shortcuts LAYER_Select LAYER_Magic>;
        };

        combo_cb_numr {
            key-positions = <POS_RH_C3R5 POS_RH_C4R5>;
            bindings = <&tog LAYER_Shortcuts>;
            layers = <LAYER_Homerow_Mods LAYER_Numbers LAYER_Shortcuts LAYER_Select LAYER_Magic>;
        };

        combo_cb_to0r {
            key-positions = <POS_RH_C3R4 POS_RH_C4R4>;
            bindings = <&to LAYER_Homerow_Mods>;
            layers = <LAYER_Homerow_Mods LAYER_Numbers LAYER_Shortcuts LAYER_Select LAYER_Magic>;
        };

        combo_cb_to0l {
            key-positions = <POS_LH_C4R4 POS_LH_C3R4>;
            bindings = <&to LAYER_Homerow_Mods>;
            layers = <LAYER_Homerow_Mods LAYER_Numbers LAYER_Shortcuts LAYER_Select LAYER_Magic>;
        };

        combo_cb_caplock {
            timeout-ms = <50>;
            key-positions = <POS_LH_T4 POS_RH_T4>;
            bindings = <&kp CAPS>;
            layers = <LAYER_Homerow_Mods>;
        };
    };
};

/* Automatically generated keymap */
/ {
    keymap {
        compatible = "zmk,keymap";


        layer_Homerow_Mods {
            bindings = <
               &kp F1                  &kp F2                  &kp F3                   &kp F4                   &kp F5                                                                                                                                                                                                                                &kp F6                    &kp F7                   &kp F8                      &kp F9    &kp F10
            &kp GRAVE                  &kp N1                  &kp N2                   &kp N3                   &kp N4  &kp N5                                                                                                                                                                                              &kp N6                    &kp N7                    &kp N8                   &kp N9                      &kp N0  &kp MINUS
              &kp ESC                   &kp Q                   &kp W                    &kp E                    &kp R   &kp T                                                                                                                                                                                               &kp Y                     &kp U                     &kp I                    &kp O                       &kp P   &kp BSLH
              &kp TAB  &HRM_left_pinky LGUI A  &HRM_left_ring1 LALT S  &HRM_left_middy LCTRL D  &HRM_left_index LSHFT F   &kp G                                                                                                                                                                                               &kp H  &HRM_right_index LSHFT J  &HRM_right_middy LCTRL K  &HRM_right_ring1 LALT L  &HRM_right_pinky LGUI SEMI    &kp SQT
            &kp EQUAL                   &kp Z                   &kp X                    &kp C                    &kp V   &kp B                     &kp LSHFT                   &kp LCTRL  &tap_layer_hold_shift LALT LAYER_Gaming  &tap_layer_hold_shift RALT LAYER_CS2  &tap_layer_hold_shift RCTRL LAYER_PUBG  &kp RSHFT   &kp N                     &kp M                 &kp COMMA                  &kp DOT                    &kp FSLH  &kp PG_UP
 &magic LAYER_Magic 0                &kp LEFT               &kp RIGHT                   &kp UP                 &kp DOWN          &thumb_L LAYER_Shortcuts RET  &thumb_L LAYER_Select BSPC                                  &kp DEL                              &kp LGUI                       &mo LAYER_Numbers  &kp SPACE                          &kp HOME                   &kp END                 &kp LBKT                    &kp RBKT  &kp PG_DN
            >;
        };

        layer_Numbers {
            bindings = <
               &trans     &trans      &trans  &trans       &trans                                                                           &trans  &trans  &trans  &trans  &trans
               &trans     &trans      &trans  &trans       &trans           &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
               &trans     &trans      &kp N7  &kp N8       &kp N9     &kp KP_SLASH                                                  &trans  &trans  &trans  &trans  &trans  &trans
               &trans  &kp EQUAL      &kp N4  &kp N5       &kp N6  &kp KP_MULTIPLY                                                  &trans  &trans  &trans  &trans  &trans  &trans
               &trans     &trans      &kp N1  &kp N2       &kp N3     &kp KP_MINUS  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F2  &trans  &trans  &trans  &trans
 &magic LAYER_Magic 0     &trans  &kp KP_DOT  &kp N0  &kp KP_PLUS                   &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Shortcuts {
            bindings = <
               &trans         &trans         &trans            &trans           &trans                                                                                       &trans  &trans      &trans     &trans  &trans
               &trans         &trans         &trans         &kp MINUS           &trans         &trans                                                           &trans       &trans  &trans      &trans     &trans  &trans
               &trans      &kp LC(W)      &kp SPACE           &kp DEL           &kp F5  &kp LC(EQUAL)                                                     &kp KP_SLASH       &kp N7  &kp N8      &kp N9     &trans  &trans
            &sum_left      &kp LC(X)      &kp LC(A)         &kp LC(C)    &kp LC(LS(V))  &kp LC(MINUS)                                                  &kp KP_MULTIPLY       &kp N4  &kp N5      &kp N6  &kp EQUAL  &trans
              &sum_up      &kp LC(Z)      &kp LC(S)         &kp LC(F)        &kp LC(V)  &kp LC(LA(D))  &trans  &trans  &trans  &trans  &trans  &trans     &kp KP_MINUS       &kp N1  &kp N2      &kp N3     &trans  &trans
 &magic LAYER_Magic 0  &kp LS(SPACE)  &kp LG(SPACE)  &kp LC(KP_MINUS)  &kp LC(KP_PLUS)                 &trans  &trans  &trans  &trans  &trans  &trans                   &kp KP_PLUS  &kp N0  &kp KP_DOT     &trans  &trans
            >;
