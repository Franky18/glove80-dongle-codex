+static void zmk_led_battery_bars(uint8_t bars, const uint8_t *addresses, size_t addresses_len) {
+    if (bars == 0) {
+        zmk_led_fill(red, addresses, addresses_len);
+        return;
+    }
+
+    zmk_led_battery_level((MIN(bars, 6) - 1) * 20, addresses, addresses_len);
+}
+
+static struct led_rgb zmk_led_endpoint_status(uint8_t endpoint_status) {
+    switch (endpoint_status) {
+    case ZMK_RGB_STATUS_ENDPOINT_ACTIVE:
+        return white;
+    case ZMK_RGB_STATUS_ENDPOINT_CONNECTED:
+        return dull_green;
+    case ZMK_RGB_STATUS_ENDPOINT_PAIRED:
+        return red;
+    default:
+        return lilac;
+    }
+}
