+static uint8_t battery_level_to_bars(uint8_t level) { return MIN(6, (level / 20) + 1); }
+
+static uint32_t zmk_rgb_status_payload(void) {
+    uint32_t payload = ZMK_RGB_STATUS_PAYLOAD_MARKER;
+
+#if IS_ENABLED(CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING)
+    uint8_t level;
+
+    if (zmk_split_central_get_peripheral_battery_level(0, &level) == 0) {
+        payload |= (uint32_t)battery_level_to_bars(level)
+                   << ZMK_RGB_STATUS_BATTERY_LHS_SHIFT;
+    }
+
+    if (zmk_split_central_get_peripheral_battery_level(1, &level) == 0) {
+        payload |= (uint32_t)battery_level_to_bars(level)
+                   << ZMK_RGB_STATUS_BATTERY_RHS_SHIFT;
+    }
+#endif
+
+    for (uint8_t i = 0; i < ZMK_RGB_STATUS_LAYER_COUNT; i++) {
+        if (zmk_keymap_layer_active(i)) {
+            payload |= 1U << (ZMK_RGB_STATUS_LAYER_SHIFT + i);
+        }
+    }
+
+#if IS_ENABLED(CONFIG_ZMK_HID_INDICATORS)
+    payload |= (zmk_hid_indicators_get_current_profile() & ZMK_RGB_STATUS_LOCK_MASK)
+               << ZMK_RGB_STATUS_LOCK_SHIFT;
+#endif
+
+    struct zmk_endpoint_instance active_endpoint = zmk_endpoints_selected();
+
+    if (!zmk_endpoints_preferred_transport_is_active()) {
+        payload |= ZMK_RGB_STATUS_OUTPUT_FALLBACK;
+    }
+
+#if IS_ENABLED(CONFIG_ZMK_BLE)
+    int active_ble_profile_index = zmk_ble_active_profile_index();
+
+    for (uint8_t i = 0; i < MIN(ZMK_BLE_PROFILE_COUNT, ZMK_RGB_STATUS_BLE_PROFILE_COUNT);
+         i++) {
+        int8_t status = zmk_ble_profile_status(i);
+        uint8_t endpoint_status = ZMK_RGB_STATUS_ENDPOINT_UNUSED;
+
+        if (status == 2 && active_endpoint.transport == ZMK_TRANSPORT_BLE &&
+            active_ble_profile_index == i) {
+            endpoint_status = ZMK_RGB_STATUS_ENDPOINT_ACTIVE;
+        } else if (status == 2) {
+            endpoint_status = ZMK_RGB_STATUS_ENDPOINT_CONNECTED;
+        } else if (status == 1) {
+            endpoint_status = ZMK_RGB_STATUS_ENDPOINT_PAIRED;
+        }
+
+        payload |= (uint32_t)endpoint_status << (ZMK_RGB_STATUS_BLE_SHIFT + (i * 2));
+    }
+#endif
+
+#if IS_ENABLED(CONFIG_USB_DEVICE_STACK)
+    enum zmk_usb_conn_state usb_state = zmk_usb_get_conn_state();
+    uint8_t endpoint_status = ZMK_RGB_STATUS_ENDPOINT_UNUSED;
+
+    if (usb_state == ZMK_USB_CONN_HID && active_endpoint.transport == ZMK_TRANSPORT_USB) {
+        endpoint_status = ZMK_RGB_STATUS_ENDPOINT_ACTIVE;
+    } else if (usb_state == ZMK_USB_CONN_HID) {
+        endpoint_status = ZMK_RGB_STATUS_ENDPOINT_CONNECTED;
+    } else if (usb_state == ZMK_USB_CONN_POWERED) {
+        endpoint_status = ZMK_RGB_STATUS_ENDPOINT_PAIRED;
+    }
+
+    payload |= (uint32_t)endpoint_status << ZMK_RGB_STATUS_USB_SHIFT;
+#endif
+
+    return payload;
+}
+
+#endif // CONFIG_ZMK_SPLIT_ROLE_CENTRAL
